<html lang="ru">
    <head>
        <%- include ('partials/head.ejs') %>
    </head>
    <body>
        <div class="preloader"></div>

        <div id="page-top">
            <div id="wrapper">
                <%- include ('partials/sidebar.ejs') %>
                <div id="content-wrapper" class="d-flex flex-column">
                    <div id="content">
                        <%- include ('partials/header.ejs') %>

                        <div class="container-fluid">
                            <div class="row">
                                <div class="col-xl-12 col-lg-12">
                                    <div class="card shadow mb-4">
                                        <div class="card-header py-3">
                                            <h6 class="m-0 font-weight-bold text-primary">
                                                <i class="fas fa-users"></i> <%= ticket.title %>
                                            </h6>
                                        </div>
                                        <div class="card-body">
                                            <div class="row">
                                                <div class="col-12">
                                                    <div class="ticket-card">
                                                        <div class="ticket-card__user">
                                                            User
                                                        </div>
                                                        <div class="ticket-card__text">
                                                            <span class="nl2br"><%= ticket.description %></span>
                                                        </div>
                                                    </div>
                                                </div>
                                                <% ticket.messages.map (message => { %>
                                                    <div class="col-12">
                                                        <div class="ticket-card">
                                                            <div class="ticket-card__user">
                                                                <%= String(message.userId) === String(ticket.userId) ? 'User' : 'Support' %>
                                                            </div>
                                                            <div class="ticket-card__text">
                                                                <span class="nl2br"><%= message.text %></span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                <% })%>
                                            </div>
                                            <div class="row">
                                                <div class="col-12">
                                                    <hr/>
                                                    <form class="user" id="ticket-add-message">
                                                        <div class="form-group">
                                                            <textarea
                                                                    rows="4"
                                                                    name="text"
                                                                    class="form-control"
                                                                    placeholder="Your answer"
                                                            ></textarea>
                                                        </div>
                                                        <input type="hidden" name="ticketId" value="<%= ticket.id %>"/>
                                                        <div class="form-group">
                                                            <div class="alert alert-message"></div>
                                                        </div>
                                                        <button type="submit" class="btn btn-primary btn-block">
                                                            Add support answer
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <%- include('partials/footer') %>
                </div>
            </div>
        </div>

        <a class="scroll-to-top rounded" href="#page-top">
            <i class="fas fa-angle-up"></i>
        </a>

        <%- include('modals/logout') %>
        <%- include('modals/message') %>
        <%- include('partials/script-utils') %>
        <%- include('scripts/help') %>
    </body>
</html>
