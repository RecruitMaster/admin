<div class="modal fade" id="userEditModal" tabindex="-1" role="dialog" aria-labelledby="userEditModalLabel">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="userEditModalLabel">User edit</h5>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span>×</span>
                </button>
            </div>
            <div class="modal-body">
                <form class="user" id="user_edit">
                    <div class="form-group">
                        <label>Status</label>
                        <select name="status" class="form-control"></select>
                    </div>
                    <input type="hidden" name="id" value="" />
                    <div class="form-group">
                        <div class="alert alert-message"></div>
                    </div>
                    <button type="submit" class="btn btn-primary btn-user btn-block">Edit</button>
                </form>
            </div>
        </div>
    </div>
</div>
