<style>
.rm-profile{min-width:265px;max-width:360px;border:1px solid #dfe9e3;border-radius:14px;background:#fff;overflow:hidden;color:#24382d;font-size:13px}.rm-profile summary{cursor:pointer;padding:13px;display:flex;gap:14px;align-items:center;justify-content:space-between}.rm-profile-state{border-radius:20px;padding:4px 8px;background:#f1f3f5;color:#59636d;font-weight:600}.rm-profile-state.is-public{background:#e5f6eb;color:#137641}.rm-profile-body{padding:0 15px 16px}.rm-profile-person{display:flex;align-items:center;gap:12px;padding:12px 0}.rm-profile-person img{width:52px;height:52px;object-fit:cover;border-radius:50%}.rm-profile-avatar{font-size:11px;color:#64796c}.rm-profile dl{display:grid;grid-template-columns:85px 1fr;gap:8px;margin:12px 0}.rm-profile dt,.rm-profile-label{color:#708176;font-size:12px;font-weight:500}.rm-profile dd{margin:0;overflow-wrap:anywhere}.rm-profile-about{white-space:pre-wrap;overflow-wrap:anywhere;max-height:180px;overflow:auto;margin-top:5px}.rm-profile-tags{display:flex;flex-wrap:wrap;gap:5px;margin:7px 0 15px}.rm-profile-tags span{background:#eef6f0;padding:4px 8px;border-radius:8px}.rm-profile-link{color:#137641;font-weight:600}.rm-write-mail{margin-top:8px;background:#eaf6ee;color:#137641;border:1px solid #d9ebdf;border-radius:8px}.rm-mail-from{padding:12px;border-radius:10px;background:#f4f8f5;color:#405a49;font-size:13px;margin-bottom:16px}
</style>
<div class="modal fade" id="personalMailModal" tabindex="-1" role="dialog" aria-labelledby="personalMailTitle" aria-hidden="true">
<div class="modal-dialog modal-lg" role="document"><div class="modal-content" style="border-radius:16px">
<form id="personalMailForm"><div class="modal-header"><h5 class="modal-title" id="personalMailTitle">Личное письмо рекрутеру</h5><button type="button" class="close" data-dismiss="modal" aria-label="Закрыть">×</button></div>
<div class="modal-body"><div class="rm-mail-from">От: Денис Кечкин &lt;dkechkin@recruitmaster.net&gt;<br>Кому: <strong id="personalMailRecipient"></strong></div>
<label for="personalMailSubject">Тема</label><input id="personalMailSubject" name="subject" class="form-control mb-3" required maxlength="200" autocomplete="off">
<label for="personalMailText">Текст письма</label><textarea id="personalMailText" name="text" class="form-control" rows="9" required maxlength="10000"></textarea>
<small class="text-muted">Будет отправлено одно личное письмо. Ответ придёт на твой адрес.</small><div class="alert mt-3" id="personalMailResult" role="status" hidden></div></div>
<div class="modal-footer"><button type="button" class="btn btn-light" data-dismiss="modal">Закрыть</button><button type="submit" class="btn btn-success">Отправить письмо</button></div></form></div></div></div>
<script>
$(function(){
let recipientId='', drafts={}, sending=false;
function saveDraft(){if(recipientId)drafts[recipientId]={subject:$('#personalMailSubject').val(),text:$('#personalMailText').val()};}
$('.rm-write-mail').on('click',function(){saveDraft();recipientId=$(this).attr('data-id');$('#personalMailRecipient').text($(this).attr('data-email'));const d=drafts[recipientId]||{subject:'',text:''};$('#personalMailSubject').val(d.subject);$('#personalMailText').val(d.text);$('#personalMailResult').prop('hidden',true);$('#personalMailForm button[type=submit]').prop('disabled',false);$('#personalMailModal').modal('show');});
$('#personalMailModal').on('hide.bs.modal',function(e){if(sending)e.preventDefault();else saveDraft();});
$('#personalMailForm').on('submit',async function(e){e.preventDefault();const button=$(this).find('[type=submit]');if(button.prop('disabled'))return;button.prop('disabled',true);sending=true;const result=$('#personalMailResult');try{const r=await fetch('/users/'+encodeURIComponent(recipientId)+'/personal-mail',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({token:<%- JSON.stringify(personalMailToken) %>,subject:$('#personalMailSubject').val(),text:$('#personalMailText').val()})});const data=await r.json();result.removeClass('alert-danger alert-success').addClass(r.ok?'alert-success':'alert-danger').text(data.message).prop('hidden',false);if(r.ok){delete drafts[recipientId];$('#personalMailSubject,#personalMailText').val('');}else button.prop('disabled',false);}catch{result.removeClass('alert-success').addClass('alert-danger').text('Ответ сервера не получен. Проверь отправку перед повтором.').prop('hidden',false);button.prop('disabled',false);}finally{sending=false;}});
});
</script>
