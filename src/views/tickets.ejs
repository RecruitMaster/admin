<html lang="ru">
    <head>
        <%- include ('partials/head.ejs') %>
    </head>
    <body>
        <div class="preloader"></div>

        <div id="page-top">
            <div id="wrapper">
                <%- include ('partials/sidebar.ejs') %>
                <div id="content-wrapper" class="d-flex flex-column">
                    <div id="content">
                        <%- include ('partials/header.ejs') %>

                        <div class="container-fluid">
                            <div class="row">
                                <div class="col-xl-12 col-lg-12">
                                    <div class="card shadow mb-4">
                                        <div class="card-header py-3">
                                            <h6 class="m-0 font-weight-bold text-primary">
                                                <i class="fas fa-users"></i> Tickets
                                            </h6>
                                        </div>
                                        <div class="card-body">
                                            <div class="row">
                                                <div class="col-sm-12">
                                                    <div class="table-responsive">
                                                        <table
                                                            class="table table-hover table-striped table-bordered table-patients"
                                                            width="100%"
                                                            cellspacing="0"
                                                        >
                                                            <thead class="thead-dark">
                                                                <tr role="row" class="sort">
                                                                    <th>Id</th>
                                                                    <th class="sorting">Title</th>
                                                                    <th class="sorting">Created</th>
                                                                    <th class="sorting">Messages</th>
                                                                    <th></th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                <% tickets.map(t => { %>
                                                                <tr>
                                                                    <td><%= t.id %></td>
                                                                    <td><%= t.title %></td>
                                                                    <td class="date"><%= t.createdAt %></td>
                                                                    <td><%= t.messagesCount %></td>
                                                                    <td>
                                                                        <a href="/help/<%= t.id %>">Open</a>
                                                                    </td>
                                                                </tr>
                                                                <% })%>
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </div>
                                                <div class="col-12"><%- include('partials/pagination') %></div>
                                            </div>
                                            <div class="row">
                                                <div class="col-12"></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <%- include('partials/footer') %>
                </div>
            </div>
        </div>

        <a class="scroll-to-top rounded" href="#page-top">
            <i class="fas fa-angle-up"></i>
        </a>

        <%- include('modals/logout') %>
        <%- include('modals/message') %>
        <%- include('partials/script-utils') %>
    </body>
</html>
