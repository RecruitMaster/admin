<html lang="ru"><head><%- include('partials/head') %></head><body><div id="wrapper"><%- include('partials/sidebar') %><div id="content-wrapper" class="d-flex flex-column"><div id="content"><%- include('partials/header') %><main class="container-fluid">
<h1 class="h3">Контакты кандидатов и согласия</h1><p>Раскрытие, копирование и переход по ссылке показывают действие с контактом. Они не подтверждают состоявшееся общение.</p>
<form method="get" class="mb-4"><label for="candidate-id">ID кандидата (необязательно)</label><div class="input-group"><input class="form-control" id="candidate-id" name="candidate" value="<%= candidate %>" placeholder="UUID кандидата"><div class="input-group-append"><button class="btn btn-success">Показать</button></div></div></form>
<div class="card shadow mb-4"><div class="card-header text-primary">Использование контактов</div><div class="card-body table-responsive"><table class="table table-hover"><thead><tr><th>Дата (Москва)</th><th>Кандидат</th><th>Рекрутер</th><th>Действие</th><th>Контакт</th></tr></thead><tbody>
<% rows.forEach(e=>{ %><tr><td><%= new Date(e.created_at).toLocaleString('ru-RU',{timeZone:'Europe/Moscow'}) %></td><td><%= e.candidate || 'Удалённый аккаунт' %><small class="d-block text-muted"><%= e.candidate_user_id %></small></td><td><%= e.recruiter || 'Удалённый аккаунт' %><small class="d-block text-muted"><%= e.recruiter_user_id %></small></td><td><%= e.channel==='crm-import'?'Передача в рабочую базу':(({reveal:'Раскрытие',copy:'Копирование',open:'Переход',resume:'Открытие резюме'})[e.action] || e.action) %></td><td><%= ({all:'Все контакты',email:'Email',phone:'Телефон',telegram:'Telegram',socialLink:'Профиль',file:'Файл резюме','crm-import':'Анкета и контакты'})[e.channel] || e.channel %></td></tr><% }) %>
<% if(!rows.length){ %><tr><td colspan="5">Пока нет событий</td></tr><% } %></tbody></table>
<nav aria-label="Страницы журнала"><% if(page>1){ %><a class="btn btn-light" href="?candidate=<%= candidate %>&page=<%= page-1 %>">Назад</a><% } %> <span><%= page %> / <%= pages %></span> <% if(page<pages){ %><a class="btn btn-light" href="?candidate=<%= candidate %>&page=<%= page+1 %>">Далее</a><% } %></nav></div></div>
<div class="card shadow mb-4"><div class="card-header text-primary">Последние 30 записей о согласиях</div><div class="card-body table-responsive"><p>Старые аккаунты не считаются согласившимися автоматически. Отметка «нет» не является положительным согласием на рассылку.</p><table class="table"><thead><tr><th>Дата (Москва)</th><th>Кандидат</th><th>Согласие</th><th>Решение</th><th>Версия / источник</th></tr></thead><tbody><% consents.forEach(e=>{ %><tr><td><%= new Date(e.created_at).toLocaleString('ru-RU',{timeZone:'Europe/Moscow'}) %></td><td><%= e.candidate || 'Без аккаунта / аккаунт удалён' %></td><td><%= e.kind==='email_marketing'?'Email-рассылки':'Персональные данные' %></td><td><%= e.accepted?'Да':e.source==='account-settings'?'Отозвано':'Не предоставлено' %></td><td><%= e.document_version %><small class="d-block"><%= e.source %></small><details><summary>Текст</summary><p style="white-space:pre-wrap"><%= e.document_text %></p></details></td></tr><% }) %></tbody></table></div></div>
</main></div><%- include('partials/footer') %></div></div><%- include('modals/logout') %></body></html>
