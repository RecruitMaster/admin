<form action="/users" method="get" class="mb-3" role="search" aria-label="Поиск пользователей">
    <div class="form-row align-items-end">
        <div class="form-group col-md-7">
            <label for="user-search">Поиск кандидатов и рекрутеров</label>
            <input id="user-search" type="search" name="search" class="form-control"
                maxlength="200" value="<%= filters.search %>" placeholder="Имя, фамилия, email, компания или ID"
                aria-describedby="user-search-help" />
        </div>
        <div class="form-group col-md-3">
            <label for="user-search-role">Роль пользователя</label>
            <select id="user-search-role" name="role" class="form-control">
                <option value="">Все пользователи</option>
                <% searchRoles.forEach(item => { %>
                    <option value="<%= item.value %>" <%= filters.role === item.value ? 'selected' : '' %>><%= item.label %></option>
                <% }) %>
            </select>
        </div>
        <div class="form-group col-md-2"><button type="submit" class="btn btn-primary">Найти</button></div>
    </div>
    <p id="user-search-help" class="small text-muted">Поиск по всей базе зарегистрированных пользователей, без учёта регистра. Можно ввести имя и фамилию в любом порядке.</p>
    <% if (filters.search || filters.role) { %><a href="/users" class="btn btn-outline-secondary btn-sm">Сбросить поиск</a><% } %>
</form>
<p role="status">Найдено пользователей: <strong><%= total %></strong></p>
