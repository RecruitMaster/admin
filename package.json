{
    "name": "",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "build": "tsc && tsc-alias && rm -rf dist/views && cp -r src/views dist/views",
        "node": "ts-node -r tsconfig-paths/register ./src/index.ts",
        "start": "nodemon ./dist/index.js",
        "dev": "nodemon --exec ts-node -r tsconfig-paths/register ./src/index.ts",
        "prod": "npm run build && npm run start",
        "clean": "rm -rf node_modules coverage dist .nyc_output",
        "lint": "tslint -t stylish --project \"tsconfig.json\"",
        "format": "prettier --write \"**/*.ts\" \"**/*.json\" \"**/*.ejs\"",
        "start:prod": "node dist/index.js",
        "pm2:start": "pm2 start npm --no-automation --name \"rm-admin\" -- start",
        "pm2:restart": "npm run build && pm2 restart rm-admin"
    },
    "keywords": [],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "@types/redis": "^4.0.10",
        "argon2": "^0.44.0",
        "body-parser": "^1.18.3",
        "connect-redis": "^9.0.0",
        "cors": "^2.8.5",
        "date-fns": "^4.1.0",
        "dotenv": "^17.2.0",
        "ejs": "^3.1.10",
        "express": "^5.1.0",
        "express-session": "^1.18.2",
        "helmet": "^8.1.0",
        "http-status": "^2.1.0",
        "ms": "^2.1.3",
        "multer": "^2.0.2",
        "nodemailer": "^10.6.0",
        "pg": "^8.16.3",
        "prettier": "^3.6.2",
        "redis": "^5.8.2",
        "typeorm": "^0.3.26",
        "uuid": "^11.1.0",
        "winston": "^3.17.0",
        "winston-daily-rotate-file": "^5.0.0"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/dotenv": "^6.1.1",
        "@types/express": "^5.0.3",
        "@types/express-session": "^1.18.2",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/morgan": "^1.9.10",
        "@types/multer": "^2.0.0",
        "@types/node": "^24.0.15",
        "@types/nodemailer": "^8.0.2",
        "morgan": "^1.10.1",
        "nodemon": "^3.1.10",
        "prettier-plugin-ejs": "^1.0.3",
        "tsc-alias": "^1.8.16",
        "tsconfig-paths": "^4.2.0",
        "tslib": "^2.8.1",
        "tslint": "^5.20.1",
        "tslint-config-prettier": "^1.18.0",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.38.0"
    }
}
